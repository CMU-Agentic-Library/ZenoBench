{
  "schema_version": 1,
  "kind": "task_goal_action_mapping",
  "meaning": "Unique Skill action predicates map to shared measured state facts and TaskEvaluator goal clauses. A candidate action is not a physical success guarantee.",
  "goals": {
    "inside": {
      "required_state_facts": ["inside"],
      "direct_actions": ["insert_object_in_container"],
      "task_evaluator": "inside",
      "aggregate_check": true,
      "note": "Repeat insert for every grounded item into the same container."
    },
    "on": {
      "required_state_facts": ["on"],
      "direct_actions": ["deposit_object_on_support", "deliver_object", "lay_edge_held_flat_object", "stand_object_on_support", "position_object_near_hint", "align_upright_object_near_hint"],
      "task_evaluator": "on",
      "aggregate_check": true,
      "note": "Ground the task's requested support and repeat for all required objects."
    },
    "on_upright": {
      "required_state_facts": ["on", "object_upright"],
      "direct_actions": ["stand_object_on_support", "align_upright_object_near_hint"],
      "task_evaluator": "on",
      "aggregate_check": true,
      "note": "Verify both support and final orientation after release."
    },
    "upright": {
      "required_state_facts": ["object_upright"],
      "direct_actions": ["stand_object_on_support", "align_upright_object_near_hint"],
      "supporting_actions": ["orient_held_object"],
      "task_evaluator": "upright",
      "aggregate_check": true,
      "note": "A held-object orientation alone is not a final released placement."
    },
    "near": {
      "required_state_facts": ["within_hint_radius"],
      "direct_actions": ["position_object_near_hint", "align_upright_object_near_hint"],
      "task_evaluator": "near",
      "aggregate_check": true,
      "note": "Each Skill checks one hint offset; TaskEvaluator checks pairwise distance of the whole group."
    },
    "heated": {
      "required_state_facts": ["temperature_at_least"],
      "direct_actions": ["attain_food_temperature"],
      "supporting_actions": ["load_microwave_cavity", "shut_microwave_door", "start_microwave_heating"],
      "task_evaluator": "heated",
      "aggregate_check": true,
      "note": "Food may require retrieval, loading, closing and starting before temperature can be attained."
    },
    "closed": {
      "required_state_facts": ["joint_closed"],
      "direct_actions": ["close_articulated_joint", "shut_microwave_door", "push_manual_handle"],
      "task_evaluator": "closed",
      "aggregate_check": true,
      "note": "Close every measured open articulated joint requested by the task."
    },
    "not_dropped": {
      "required_state_facts": [],
      "direct_actions": [],
      "supporting_actions": ["acquire_object", "scoop_floor_object", "deposit_object_on_support", "insert_object_in_container"],
      "task_evaluator": "not_dropped",
      "aggregate_check": true,
      "terminal_invariant": true,
      "note": "No single Skill can establish this whole-trajectory invariant; it is checked from initial and final scene state."
    }
  }
}
