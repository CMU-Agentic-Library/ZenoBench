{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subgraph.schema.json",
  "title": "ZenoBench Skill Subgraph v2",
  "description": "A plan for one subgoal: SkillNode calls with typed arguments and dependencies. Validated by skill_library/graph.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "subgoal_id", "nodes"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "skill_subgraph"},
    "subgoal_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill", "args", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "skill": {"type": "string", "description": "A verb (e.g. \"pick\") or a SkillNode ID (e.g. \"skill_017\")."},
          "args": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {"type": "object", "additionalProperties": false, "required": ["ref"],
                 "properties": {"ref": {"type": "string", "minLength": 1}},
                 "description": "A scene noun (object, support, articulated part, appliance, button, room); grounded through the bindings map."},
                {"type": "object", "additionalProperties": false, "required": ["value"],
                 "properties": {"value": {}},
                 "description": "A literal: number, vector, hand, list of objects, category map, or an exact scene name."},
                {"type": "object", "additionalProperties": false, "required": ["from"],
                 "properties": {"from": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*\\.[a-z_]+$"}},
                 "description": "A measured output of an ancestor node, e.g. \"n1.found_on\"."}
              ]
            }
          },
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
