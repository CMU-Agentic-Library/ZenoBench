{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subgraph.schema.json",
  "title": "ZenoBench Skill Subgraph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "subgoal_id",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "skill_subgraph"
    },
    "subgoal_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill_id",
          "args",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "skill_id": {
            "type": "string",
            "pattern": "^skill_[0-9]+$"
          },
          "args": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 3,
                          "items": {
                            "type": "number"
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
