  <version>1.0.0</version>
  <description>Zeno Malo EDU robot with two Malo Pinch grippers.</description>
  <maintainer email="maintainer@example.com">Zeno Malo Maintainers</maintainer>
  <!-- Software only; imported CAD assets retain their owner's terms. -->
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
