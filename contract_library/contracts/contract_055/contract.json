{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_055",
 "verb": "fetch",
 "noun": "object",
 "name": "Fetch an object to a receptacle",
 "description": "Bring one object to a support or container: the robot goes to the object, picks it up, carries it to the receptacle and puts it there.",
 "group": "multi_object",
 "inputs": {
  "object": {
   "type": "object_ref",
   "required": true,
   "description": "What to bring."
  },
  "receptacle": {
   "type": "receptacle_ref",
   "required": true,
   "description": "Destination support or open container."
  }
 },
 "outputs": {},
 "requires": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  }
 ],
 "ensures": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  }
 ],
 "invalidates": [
  "on($object,*)",
  "inside($object,*)",
  "at_initial_place($object)",
  "base_near(*)",
  "reachable(*)"
 ],
 "precheck": [
  {
   "predicate": "hand_empty(hand=right)",
   "name": "hand_empty",
   "args": {
    "hand": "right"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  },
  {
   "predicate": "uncovered(container=$receptacle)",
   "name": "uncovered",
   "args": {
    "container": "$receptacle"
   },
   "negated": false,
   "meaning": "No lid rests on the container rim.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "container_profile",
    "asset_tags"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "path to_container"
  }
 ],
 "verifier": [
  {
   "predicate": "hand_empty(hand=right)",
   "name": "hand_empty",
   "args": {
    "hand": "right"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  },
  {
   "predicate": "inside(object=$object, container=$receptacle)",
   "name": "inside",
   "args": {
    "object": "$object",
    "container": "$receptacle"
   },
   "negated": false,
   "meaning": "Object centre inside the container's wall profile, between its floor and 3 cm above the rim.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "container_profile"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "path to_container"
  },
  {
   "predicate": "on(object=$object, support=$receptacle)",
   "name": "on",
   "args": {
    "object": "$object",
    "support": "$receptacle"
   },
   "negated": false,
   "meaning": "Object bottom within -2..+5 cm of the support height with its centre over the support box.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "asset_annotation",
    "support_annotation"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "path to_surface"
  }
 ],
 "noun_binding": {
  "object": {
   "type": "object_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  },
  "receptacle": {
   "type": "receptacle_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "fetch_object",
  "verb": "fetch",
  "noun": "object",
  "arguments": [
   "object",
   "receptacle"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "to_container",
    "when": [
     {
      "noun": "receptacle",
      "field": "kind",
      "op": "equals",
      "value": "object"
     }
    ],
    "steps": [
     {
      "call": "navigate",
      "args": {
       "destination": "$object"
      }
     },
     {
      "call": "pick",
      "args": {
       "object": "$object"
      }
     },
     {
      "call": "navigate",
      "args": {
       "destination": "$receptacle"
      }
     },
     {
      "call": "place",
      "args": {
       "object": "$object",
       "receptacle": "$receptacle"
      }
     }
    ],
    "requires": [
     {
      "pred": "uncovered",
      "args": {
       "container": "$receptacle"
      }
     }
    ],
    "ensures": [
     {
      "pred": "inside",
      "args": {
       "object": "$object",
       "container": "$receptacle"
      }
     }
    ],
    "note": ""
   },
   {
    "path_id": "to_surface",
    "when": [
     {
      "noun": "receptacle",
      "field": "kind",
      "op": "equals",
      "value": "support"
     }
    ],
    "steps": [
     {
      "call": "navigate",
      "args": {
       "destination": "$object"
      }
     },
     {
      "call": "pick",
      "args": {
       "object": "$object"
      }
     },
     {
      "call": "navigate",
      "args": {
       "destination": "$receptacle"
      }
     },
     {
      "call": "place",
      "args": {
       "object": "$object",
       "receptacle": "$receptacle"
      }
     }
    ],
    "requires": [],
    "ensures": [
     {
      "pred": "on",
      "args": {
       "object": "$object",
       "support": "$receptacle"
      }
     }
    ],
    "note": ""
   }
  ]
 },
 "failure": {
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
