      "predicate": "right_hand_empty",
      "enforcement": "policy_attempt"
    },
    {
      "predicate": "object_on_floor",
      "enforcement": "policy_attempt"
    },
    {
      "predicate": "pregrasp_reachable",
      "enforcement": "policy_attempt"
    }
  ],
  "achieves": [
