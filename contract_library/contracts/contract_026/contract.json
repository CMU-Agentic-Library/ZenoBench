{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_026",
 "verb": "place",
 "noun": "object",
 "name": "Place a held object",
 "description": "Put the right-held object down on a support surface or into an open container and release it. How it is put down is chosen automatically from the receptacle and grasp: into a microwave (insert, release, withdraw), into a container, an edge-held flat object slid back over an edge, onto an ordinary surface (optionally near a hint point), or while driving past.",
 "group": "grasp_and_hand",
 "inputs": {
  "object": {
   "type": "object_ref",
   "required": true,
   "description": "The held object."
  },
  "receptacle": {
   "type": "receptacle_ref",
   "required": true,
   "description": "A support surface or an open container."
  },
  "hint_xy": {
   "type": "xy",
   "required": false,
   "description": "Optional preferred position on a surface."
  },
  "pass_by": {
   "type": "pose2d",
   "required": false,
   "description": "Optional base waypoint: place while driving past."
  }
 },
 "outputs": {
  "position": {
   "type": "xy",
   "description": "Measured bottom position after release."
  }
 },
 "requires": [
  {
   "pred": "holding",
   "args": {
    "hand": "right",
    "object": "$object"
   }
  },
  {
   "pred": "base_near",
   "args": {
    "place": "$receptacle"
   }
  }
 ],
 "ensures": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  }
 ],
 "invalidates": [
  "holding(right,$object)",
  "presenting($object)",
  "base_clear_of(*)"
 ],
