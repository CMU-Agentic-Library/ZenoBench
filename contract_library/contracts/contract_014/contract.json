{
  "schema_version": 1,
  "kind": "skill_contract",
  "contract_id": "contract_014",
  "skill_id": "skill_006",
  "name": "Place an object in a container",
  "description": "Release a right-held object into an annotated container and verify the final geometry.",
  "scope": {
    "unit": "one planner-visible place-in-container attempt",
    "includes": [
      "move the right-held object to one annotated container",
      "release and verify inside(object, container)"
    ],
    "excludes": [
      "placing on a bare support surface",
      "choosing another container when this one is missing",
      "checking the entire task goal"
    ]
  },
  "inputs": {
    "object": {
      "type": "object_ref",
      "required": true,
      "description": "The held object to place."
    },
    "container": {
      "type": "container_ref",
      "required": true,
      "description": "The target container."
    }
  },
  "requires": [
    {
      "predicate": "held_by_right_hand",
      "arg": "object",
      "enforcement": "contract_precheck"
    },
    {
      "predicate": "container_annotated",
      "arg": "container",
      "enforcement": "contract_noun_binding"
    },
    {
      "predicate": "container_accessible",
      "arg": "container",
      "enforcement": "policy_attempt"
    }
  ],
  "achieves": [
    {
      "predicate": "inside",
      "args": [
        "object",
        "container"
      ],
      "verification": "contract_runner"
    },
    {
      "predicate": "right_hand_empty",
      "verification": "contract_runner"
    }
  ],
  "expected_state_change": [
    "inside",
    "right_hand_empty"
  ],
  "verifier": {
    "legacy_family_contract": "contract_003",
    "route": "container",
    "check": "ContractRunner._before + _verify",
    "on_failure": "record partial state and stop"
  },
  "policy_plan": {
    "kind": "sequence",
    "steps": [
      {
        "policy_id": "policy_016",
        "args": [
          {
            "arg": "object"
          },
          {
            "arg": "container"
          }
        ]
      }
    ]
  },
  "legacy_call_args": [
    "object",
    "container"
  ],
  "argument_transforms": {
    "container": "in:"
  },
  "availability": "representative_runs_only",
  "failure": {
    "action": "stop_and_reobserve",
    "fallback": "upper_layer_replans_from_measured_state",
    "automatic_fallback": false
  },
  "fallback_hints": [],
  "noun_bindings": {
    "object": {
      "argument": "object",
      "kind": "scene_object",
      "source": "rig.ann",
      "required": true,
      "requires_right_held": true
    },
    "container": {
      "argument": "container",
      "kind": "container",
      "source": "rig.ann",
      "required": true,
      "required_annotation": "asset.container"
    }
  },
  "action_predicate": {
    "name": "insert_object_in_container",
    "verb": "insert",
    "noun": "object_in_container",
    "arguments": [
      "object",
      "container"
    ],
    "verified_by": [
      "inside",
      "right_hand_empty"
    ]
  }
}
