{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_041",
 "verb": "center",
 "noun": "object",
 "name": "Center an object on its support",
 "description": "Push an object back from the support edges until every edge margin is at least the requested value (secures an item left overhanging).",
 "group": "contact",
 "inputs": {
  "object": {
   "type": "object_ref",
   "required": true,
   "description": "The object near an edge."
  },
  "margin_m": {
   "type": "positive_number",
   "required": true,
   "description": "Required margin to every edge.",
   "default": 0.06
  }
 },
 "outputs": {},
 "requires": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  },
  {
   "pred": "base_near",
   "args": {
    "place": "$object"
   }
  }
 ],
 "ensures": [
  {
   "pred": "away_from_edge",
   "args": {
    "object": "$object",
    "margin_m": "$margin_m"
   }
  }
 ],
 "invalidates": [
  "edge_overhang($object)"
 ],
 "precheck": [
  {
   "predicate": "hand_empty(hand=right)",
   "name": "hand_empty",
   "args": {
    "hand": "right"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  },
  {
   "predicate": "base_near(place=$object)",
   "name": "base_near",
   "args": {
    "place": "$object"
   },
   "negated": false,
   "meaning": "Base centre within 1.3 m of the place's footprint (inside the room for a room).",
   "kind": "fluent",
   "gt_sources": [
    "base_pose",
    "scene_annotation"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  }
 ],
 "verifier": [
  {
   "predicate": "away_from_edge(object=$object, margin_m=$margin_m)",
   "name": "away_from_edge",
   "args": {
    "object": "$object",
    "margin_m": "$margin_m"
   },
   "negated": false,
   "meaning": "Object footprint at least the margin inside every edge of its support.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "support_annotation"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "object": {
   "type": "object_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "center_object",
  "verb": "center",
  "noun": "object",
  "arguments": [
   "object",
   "margin_m"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "push_inward",
    "when": [],
    "steps": [
     {
      "policy": "policy_083",
      "args": [
       "$object",
       "$margin_m"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   }
  ]
 },
 "failure": {
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
