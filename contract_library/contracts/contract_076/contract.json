{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_076",
 "verb": "stop",
 "noun": "appliance",
 "name": "Stop an appliance",
 "description": "Switch an appliance's heat off: press the stove power key off, or open the microwave door, which ends its cycle.",
 "group": "articulated_and_appliance",
 "inputs": {
  "appliance": {
   "type": "appliance_ref",
   "required": true,
   "description": "kitchen_stove or kitchen_microwave."
  }
 },
 "outputs": {},
 "requires": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  },
  {
   "pred": "base_near",
   "args": {
    "place": "$appliance"
   }
  }
 ],
 "ensures": [
  {
   "pred": "heating",
   "args": {
    "appliance": "$appliance"
   },
   "negated": true
  }
 ],
 "invalidates": [],
 "precheck": [
  {
   "predicate": "hand_empty(hand=right)",
   "name": "hand_empty",
   "args": {
    "hand": "right"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  },
  {
   "predicate": "base_near(place=$appliance)",
   "name": "base_near",
   "args": {
    "place": "$appliance"
   },
   "negated": false,
   "meaning": "Base centre within 1.3 m of the place's footprint (inside the room for a room).",
   "kind": "fluent",
   "gt_sources": [
    "base_pose",
    "scene_annotation"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  }
 ],
 "verifier": [
  {
   "predicate": "not heating(appliance=$appliance)",
   "name": "heating",
   "args": {
    "appliance": "$appliance"
   },
   "negated": true,
   "meaning": "The appliance's heat source is on (microwave cycle or stove burner).",
   "kind": "fluent",
   "gt_sources": [
    "thermal_state"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  },
  {
   "predicate": "is_open(articulated=$appliance)",
   "name": "is_open",
   "args": {
    "articulated": "$appliance"
   },
   "negated": false,
   "meaning": "Joint at least 60 % of the way from closed to its annotated open value.",
   "kind": "fluent",
   "gt_sources": [
    "articulation_joint",
    "articulation_annotation"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "path microwave_door"
  }
 ],
 "noun_binding": {
  "appliance": {
   "type": "appliance_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "stop_appliance",
  "verb": "stop",
  "noun": "appliance",
  "arguments": [
   "appliance"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "stove_key_off",
    "when": [
     {
      "noun": "appliance",
      "field": "category",
      "op": "equals",
      "value": "stove"
     }
    ],
    "steps": [
     {
      "policy": "policy_094",
      "args": [
       "@appliance.power_button"
      ],
      "kwargs": {
       "state": false
      }
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   },
   {
    "path_id": "microwave_door",
    "when": [
     {
      "noun": "appliance",
      "field": "category",
      "op": "equals",
      "value": "microwave"
     }
    ],
    "steps": [
     {
      "policy": "policy_024",
      "args": [
       "$appliance"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [
     {
      "pred": "is_open",
      "args": {
       "articulated": "$appliance"
      }
     }
    ],
    "note": ""
   }
  ]
 },
 "failure": {
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
