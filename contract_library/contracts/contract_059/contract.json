{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_059",
 "skill_id": "skill_051",
 "verb": "empty",
 "noun": "container",
 "name": "Empty a container",
 "description": "Take every object out of a container and put it on/into a destination receptacle.",
 "group": "multi_object",
 "inputs": {
  "container": {
   "type": "container_ref",
   "required": true,
   "description": "The container to empty."
  },
  "receptacle": {
   "type": "receptacle_ref",
   "required": true,
   "description": "Where the contents go (a container for the pouring path)."
  }
 },
 "outputs": {
  "moved": {
   "type": "object_list",
   "description": "Objects that were taken out."
  }
 },
 "requires": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  },
  {
   "pred": "uncovered",
   "args": {
    "container": "$container"
   }
  }
 ],
 "ensures": [
  {
   "pred": "container_empty",
   "args": {
    "container": "$container"
   }
  }
 ],
 "invalidates": [],
 "precheck": [
  {
   "predicate": "hand_empty(hand=right)",
   "name": "hand_empty",
   "args": {
    "hand": "right"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  },
  {
   "predicate": "uncovered(container=$container)",
   "name": "uncovered",
   "args": {
    "container": "$container"
   },
   "negated": false,
   "meaning": "No lid rests on the container rim.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "container_profile",
    "asset_tags"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  }
 ],
 "verifier": [
  {
   "predicate": "container_empty(container=$container)",
   "name": "container_empty",
   "args": {
    "container": "$container"
   },
   "negated": false,
   "meaning": "No annotated object is inside the container.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "container_profile"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "container": {
   "type": "container_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  },
  "receptacle": {
   "type": "receptacle_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "empty_container",
  "verb": "empty",
  "noun": "container",
  "arguments": [
   "container",
   "receptacle"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "pick_each_inside",
    "when": [],
    "steps": [
     {
      "foreach": "@container.contents",
      "as": "item",
      "steps": [
       {
        "policy": "policy_092",
        "args": [
         "$container"
        ],
        "kwargs": {}
       },
       {
        "policy": "policy_061",
        "args": [
         "$item"
        ],
        "kwargs": {}
       },
       {
        "call": "navigate",
        "args": {
         "destination": "$receptacle"
        }
       },
       {
        "call": "place",
        "args": {
         "object": "$item",
         "receptacle": "$receptacle"
        }
       }
      ]
     }
    ],
    "requires": [],
    "ensures": [],
    "note": "Take the items out one by one. (Pouring loose solids needs the cup past ~90 deg, which the arm cannot reach over the stove; the pour path is kept as an alternative.)"
   },
   {
    "path_id": "pour_out",
    "when": [
     {
      "noun": "container",
      "field": "grasp_types",
      "op": "contains",
      "value": "rim_pinch"
     },
     {
      "noun": "receptacle",
      "field": "kind",
      "op": "equals",
      "value": "object"
     }
    ],
    "steps": [
     {
      "call": "navigate",
      "args": {
       "destination": "$container"
      }
     },
     {
      "call": "pick",
      "args": {
       "object": "$container"
      }
     },
     {
      "call": "navigate",
      "args": {
       "destination": "$receptacle"
      }
     },
     {
      "call": "pour",
      "args": {
       "source": "$container",
       "target": "$receptacle"
      }
     },
     {
      "call": "place",
      "args": {
       "object": "$container",
       "receptacle": "@container.support"
      }
     }
    ],
    "requires": [],
    "ensures": [],
    "note": "A cup or mug of loose items is emptied by pouring, then put back."
   }
  ]
 },
 "relations": [
  {
   "kind": "alternative",
   "to": "clear",
   "when": "the items lie on a surface instead",
   "bind": {},
   "reason": "",
   "to_skill_id": "skill_050"
  },
  {
   "kind": "fallback",
   "to": "uncover",
   "when": "the container has its lid on",
   "bind": {
    "container": "$container"
   },
   "reason": "",
   "fallback_type": "repair",
   "repairs": "uncovered",
   "to_skill_id": "skill_046"
  }
 ],
 "failure": {
  "automatic_fallback": "nested calls only: a failed precondition with a matching repair fallback runs the repair once and retries; top-level calls stop",
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
