{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_029",
 "skill_id": "skill_021",
 "verb": "release",
 "noun": "object",
 "name": "Release an object",
 "description": "Open one gripper where the object already rests (e.g. let go of a braced pot, or of an object that was set down by another action) and back the fingers off.",
 "group": "grasp_and_hand",
 "inputs": {
  "object": {
   "type": "object_ref",
   "required": true,
   "description": "The object in the hand."
  },
  "hand": {
   "type": "hand",
   "required": true,
   "description": "Which gripper opens.",
   "default": "right",
   "enum": [
    "right",
    "left"
   ]
  }
 },
 "outputs": {},
 "requires": [
  {
   "pred": "holding",
   "args": {
    "hand": "$hand",
    "object": "$object"
   }
  }
 ],
 "ensures": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "$hand"
   }
  }
 ],
 "invalidates": [
  "holding($hand,$object)",
  "steadied($object)"
 ],
 "precheck": [
  {
   "predicate": "holding(hand=$hand, object=$object)",
   "name": "holding",
   "args": {
    "hand": "$hand",
    "object": "$object"
   },
   "negated": false,
   "meaning": "The object is in the given gripper: fingers not shut, TCP-to-body distance unchanged since the grasp.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state",
    "finger_joints",
    "object_pose",
    "arm_fk"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  }
 ],
 "verifier": [
  {
   "predicate": "hand_empty(hand=$hand)",
   "name": "hand_empty",
   "args": {
    "hand": "$hand"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "object": {
   "type": "object_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "release_object",
  "verb": "release",
  "noun": "object",
  "arguments": [
