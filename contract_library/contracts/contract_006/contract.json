{
  "schema_version": 1,
  "kind": "contract",
  "contract_id": "contract_006",
  "legacy_id": "push.v1",
  "description": "Move an object along its support by contact.",
  "scope": "One directed contact move of an object along its support.",
  "inputs": {
    "object": {
      "type": "object_id",
      "required": true
    },
    "support": {
      "type": "support_id",
      "required": true
    },
    "direction_xy": {
      "type": "unit_vec2",
      "required": true
    },
    "distance_m": {
      "type": "positive_number",
      "required": true
    },
    "enough": {
      "type": "nonnegative_number",
      "required": false,
      "description": "Optional minimum measured progress in metres; defaults to max(0.01, distance_m * 0.5)."
    }
  },
  "requires": [
    {
      "predicate": "right_hand_empty",
      "check": "runner"
    },
    {
      "predicate": "object_on_support",
      "args": [
        "object",
        "support"
      ],
      "check": "policy_attempt"
    }
  ],
  "achieves": [
    {
      "predicate": "displacement_along",
      "args": [
        "object",
        "direction_xy",
        "enough"
      ],
      "check": "runner"
    }
  ],
  "outcomes": {
    "success": "measured progress",
    "failure": "object may have moved or fallen"
  },
  "verifier": "compare pre/post object positions along direction",
  "not_guaranteed": [
    "object remains on support after the push"
  ],
  "routes": {
    "auto": {
      "policy_id": "policy_026",
      "legacy_dispatcher": null
    },
    "behind": {
      "policy_id": "policy_043",
      "legacy_dispatcher": null
    },
    "top_drag": {
      "policy_id": "policy_044",
      "legacy_dispatcher": null
    }
  }
}
