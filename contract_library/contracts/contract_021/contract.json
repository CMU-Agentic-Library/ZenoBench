{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_021",
 "verb": "search",
 "noun": "object",
 "name": "Search for an object",
 "description": "Find an object whose location is unknown: visit the supports of a room in order of distance and aim the head at each surface until the object is seen.",
 "group": "perception_and_gesture",
 "inputs": {
  "object": {
   "type": "object_ref",
   "required": true,
   "description": "The object to find."
  },
  "region": {
   "type": "room_ref",
   "required": false,
   "description": "Room to search; default the robot's room."
  }
 },
 "outputs": {
  "found_on": {
   "type": "support_ref",
   "description": "Support under the object when it was seen."
  },
  "visited": {
   "type": "object_list",
   "description": "Furniture visited in order."
  }
 },
 "requires": [],
 "ensures": [
  {
   "pred": "observed",
   "args": {
    "target": "$object"
   }
  }
 ],
 "invalidates": [
  "base_near(*)",
  "reachable(*)",
  "facing(*)",
  "in_view(*)"
 ],
 "precheck": [],
 "verifier": [
  {
   "predicate": "observed(target=$object)",
   "name": "observed",
   "args": {
    "target": "$object"
   },
   "negated": false,
   "meaning": "The robot saw the target in its head camera during this episode (set by look, search, inspect, explore).",
   "kind": "memory",
   "gt_sources": [
    "robot_memory"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "object": {
   "type": "object_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  },
  "region": {
   "type": "room_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "search_object",
  "verb": "search",
  "noun": "object",
  "arguments": [
   "object",
   "region"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "room_sweep",
    "when": [],
    "steps": [
     {
      "policy": "policy_070",
      "args": [
       "$object",
       "$region"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   }
  ]
 },
 "failure": {
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
