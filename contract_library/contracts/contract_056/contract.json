{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_056",
 "verb": "collect",
 "noun": "objects",
 "name": "Collect objects into a container",
 "description": "Put every listed object into one container (fetch each in turn).",
 "group": "multi_object",
 "inputs": {
  "objects": {
   "type": "object_list",
   "required": true,
   "description": "Objects to gather."
  },
  "container": {
   "type": "container_ref",
   "required": true,
   "description": "The container."
  }
 },
 "outputs": {},
 "requires": [
  {
   "pred": "hand_empty",
   "args": {
    "hand": "right"
   }
  },
  {
   "pred": "uncovered",
   "args": {
    "container": "$container"
   }
  }
 ],
 "ensures": [
  {
   "pred": "all_inside",
   "args": {
    "objects": "$objects",
    "container": "$container"
   }
  }
 ],
 "invalidates": [],
 "precheck": [
  {
   "predicate": "hand_empty(hand=right)",
   "name": "hand_empty",
   "args": {
    "hand": "right"
   },
   "negated": false,
   "meaning": "The given gripper holds nothing.",
   "kind": "fluent",
   "gt_sources": [
    "gripper_state"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  },
  {
   "predicate": "uncovered(container=$container)",
   "name": "uncovered",
   "args": {
    "container": "$container"
   },
   "negated": false,
   "meaning": "No lid rests on the container rim.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "container_profile",
    "asset_tags"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
  }
 ],
 "verifier": [
  {
   "predicate": "all_inside(objects=$objects, container=$container)",
   "name": "all_inside",
   "args": {
    "objects": "$objects",
    "container": "$container"
   },
   "negated": false,
   "meaning": "Every listed object is inside the container.",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "container_profile"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "container": {
   "type": "container_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "collect_objects",
  "verb": "collect",
  "noun": "objects",
  "arguments": [
   "objects",
   "container"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "fetch_each",
    "when": [],
    "steps": [
     {
      "foreach": "$objects",
      "as": "item",
      "steps": [
       {
        "call": "fetch",
        "args": {
         "object": "$item",
         "receptacle": "$container"
        }
       }
      ]
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   }
  ]
 },
 "failure": {
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
