    "appliance": "$appliance"
   },
   "negated": false,
   "meaning": "Object centre inside the appliance cavity box (microwave) or body box (refrigerator).",
   "kind": "fluent",
   "gt_sources": [
    "object_pose",
    "appliance_annotation"
   ],
   "checked": "before execution on live GT state; the Contract does not move if false",
   "scope": "all paths"
