{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_052",
 "skill_id": "skill_044",
 "verb": "chill",
 "noun": "food",
 "name": "Chill food",
 "description": "Keep food in the closed refrigerator until it is at or below a target temperature.",
 "group": "articulated_and_appliance",
 "inputs": {
  "food": {
   "type": "object_ref",
   "required": true,
   "description": "The food item with thermal state."
  },
