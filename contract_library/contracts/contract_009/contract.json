{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_009",
 "verb": "navigate",
 "noun": "place",
 "name": "Navigate to a place",
 "description": "Drive the holonomic base to a free stand-off pose next to a room, piece of furniture, support, articulated part or object. The arm is tucked when empty, or held in the compact carry pose with the load.",
 "group": "base_and_body",
 "inputs": {
  "destination": {
   "type": "place_ref",
   "required": true,
   "description": "Where to go: a room, furniture, support, articulated part or object."
  }
 },
 "outputs": {
  "base_pose": {
   "type": "pose2d",
   "description": "Measured base pose [x, y, yaw_deg] at arrival."
  }
 },
 "requires": [],
 "ensures": [
  {
   "pred": "base_near",
   "args": {
    "place": "$destination"
   }
  }
 ],
 "invalidates": [
  "base_near(*)",
  "reachable(*)",
  "facing(*)",
  "in_view(*)",
  "base_clear_of(*)",
  "pointing_at(*)",
  "presenting(*)"
 ],
 "precheck": [],
 "verifier": [
  {
   "predicate": "base_near(place=$destination)",
   "name": "base_near",
   "args": {
    "place": "$destination"
   },
   "negated": false,
   "meaning": "Base centre within 1.3 m of the place's footprint (inside the room for a room).",
   "kind": "fluent",
   "gt_sources": [
    "base_pose",
    "scene_annotation"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "destination": {
   "type": "place_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "navigate_place",
  "verb": "navigate",
  "noun": "place",
  "arguments": [
   "destination"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "two_hand_carry",
    "when": [
     {
      "noun": "robot",
      "field": "both_hold_same",
      "op": "truthy",
      "value": true
     }
    ],
    "steps": [
     {
      "policy": "policy_097",
      "args": [
       "$destination"
      ],
      "kwargs": {},
      "as": "plan"
     },
     {
      "policy": "policy_058",
      "args": [
       "@robot.right_object",
       "#plan.pose"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": "An object held by both grippers moves at the slow bimanual carry speed."
   },
   {
    "path_id": "carry",
    "when": [
     {
      "noun": "robot",
      "field": "right_held",
      "op": "truthy",
      "value": true
     }
    ],
    "steps": [
     {
      "policy": "policy_097",
      "args": [
       "$destination"
      ],
      "kwargs": {},
      "as": "plan"
     },
     {
      "policy": "policy_002",
      "args": [
       "#plan.pose"
      ],
      "kwargs": {
       "name": "@robot.right_object",
       "min_bottom_z": "#plan.carry_bottom_z"
      }
     }
    ],
    "requires": [],
    "ensures": [],
    "note": "Back off, lift the load to carry height, plan with extra clearance, drive slowly."
   },
   {
    "path_id": "empty",
    "when": [],
    "steps": [
     {
      "policy": "policy_097",
      "args": [
       "$destination"
      ],
      "kwargs": {},
      "as": "plan"
     },
     {
      "policy": "policy_001",
      "args": [
       "#plan.pose"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   }
  ]
 },
 "failure": {
  "stop_and_report": true
 },
 "scope": {
  "includes": [
   "stand-off pose search around the noun's footprint",
   "A* base path",
   "carry posture if loaded"
  ],
  "excludes": [
   "arm reachability of a specific target",
   "grasping"
  ]
 }
}
