{
 "schema_version": 2,
 "kind": "skill_contract",
 "contract_id": "contract_012",
 "skill_id": "skill_004",
 "verb": "retreat",
 "noun": "obstacle",
 "name": "Retreat from an obstacle",
 "description": "Back the base straight away from a piece of furniture, appliance or object until it is at least the given distance away; a held load stays held.",
 "group": "base_and_body",
 "inputs": {
  "obstacle": {
   "type": "place_ref",
   "required": true,
   "description": "What to back away from."
  },
  "distance_m": {
   "type": "positive_number",
   "required": true,
   "description": "Required clearance from the obstacle footprint.",
   "default": 0.4
  }
 },
 "outputs": {
  "moved_m": {
   "type": "number",
   "description": "Measured base displacement."
  }
 },
 "requires": [],
 "ensures": [
  {
   "pred": "base_clear_of",
   "args": {
    "place": "$obstacle",
    "distance_m": "$distance_m"
   }
  }
 ],
 "invalidates": [
  "base_near(*)",
  "reachable(*)",
  "facing(*)",
  "in_view(*)"
 ],
 "precheck": [],
 "verifier": [
  {
   "predicate": "base_clear_of(place=$obstacle, distance_m=$distance_m)",
   "name": "base_clear_of",
   "args": {
    "place": "$obstacle",
    "distance_m": "$distance_m"
   },
   "negated": false,
   "meaning": "Base centre at least the given distance from the place's footprint.",
   "kind": "fluent",
   "gt_sources": [
    "base_pose",
    "scene_annotation"
   ],
   "checked": "after the policy chain on live GT state; the action is reported only if true",
   "scope": "all paths"
  }
 ],
 "noun_binding": {
  "obstacle": {
   "type": "place_ref",
   "attributes_from": "zeno_skills.skill_runtime.bind_nouns (GT)"
  }
 },
 "action_predicate": {
  "name": "retreat_obstacle",
  "verb": "retreat",
  "noun": "obstacle",
  "arguments": [
   "obstacle",
   "distance_m"
  ]
 },
 "policy_plan": {
  "selection": "first path whose noun conditions all hold, decided before any motion",
  "on_no_match": "NO_PATH: the Contract refuses without moving",
  "paths": [
   {
    "path_id": "microwave_door_sweep",
    "when": [
     {
      "noun": "obstacle",
      "field": "instance",
      "op": "equals",
      "value": "kitchen_microwave"
     }
    ],
    "steps": [
     {
      "policy": "policy_030",
      "args": [
       "$obstacle"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": "The microwave's measured hinge-clearance pose (also when loaded)."
   },
   {
    "path_id": "bimanual_or_left_load",
    "when": [
     {
      "noun": "robot",
      "field": "left_held",
      "op": "truthy",
      "value": true
     }
    ],
    "steps": [
     {
      "policy": "policy_067",
      "args": [
       "$obstacle",
       "$distance_m"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   },
   {
    "path_id": "loaded",
    "when": [
     {
      "noun": "robot",
      "field": "right_held",
      "op": "truthy",
      "value": true
     }
    ],
    "steps": [
     {
      "policy": "policy_035",
      "args": [
       "$distance_m"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": "Straight reverse with the right-hand load."
   },
   {
    "path_id": "empty",
    "when": [],
    "steps": [
     {
      "policy": "policy_100",
      "args": [
       "$obstacle",
       "$distance_m"
      ],
      "kwargs": {},
      "as": "plan"
     },
     {
      "policy": "policy_037",
      "args": [
       "#plan.forward_m"
      ],
      "kwargs": {}
     }
    ],
    "requires": [],
    "ensures": [],
    "note": ""
   }
  ]
 },
 "relations": [
  {
   "kind": "sequence",
   "to": "navigate",
   "when": "the robot must leave after backing out",
   "bind": {},
   "reason": "free start cell",
   "to_skill_id": "skill_001",
   "sequence_type": "then"
  },
  {
   "kind": "sequence",
   "to": "open",
   "when": "a door's swing needs room in front of the robot",
   "bind": {
    "articulated": "$obstacle"
   },
   "reason": "",
   "to_skill_id": "skill_040",
   "sequence_type": "then"
  }
 ],
 "failure": {
  "automatic_fallback": "nested calls only: a failed precondition with a matching repair fallback runs the repair once and retries; top-level calls stop",
  "stop_and_report": true
 },
 "scope": {
  "includes": [],
  "excludes": []
 }
}
