# Copy to baseline/.env (git-ignored) and fill in the keys you have; baseline/vlm.py reads it.
# Variables already set in the shell take precedence.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GEMINI_API_KEY=        (Gemini is not in the paper set for now)
# Local / remote vLLM serving Qwen3.5-4B (OpenAI-compatible)
SHIFT_VLLM_URL=http://localhost:8001/v1
SHIFT_VLLM_KEY=EMPTY
# Defaults for run_episode (optional)
# SHIFT_MODEL=claude-opus-5-5
# SHIFT_MAX_CALLS=60
