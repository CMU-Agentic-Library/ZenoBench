{
  "schema_version": 1,
  "kind": "contract_profiles",
  "contracts": {
    "navigate.v1": {
      "scope": "One base move to a target pose, preserving any current grasp.",
      "requires": [
        {
          "predicate": "target_navigable",
          "check": "policy_attempt"
        },
        {
          "predicate": "carried_object_matches_state",
          "check": "not_enforced"
        }
      ],
      "achieves": [
        {
          "predicate": "base_at",
          "args": [
            "pose"
          ],
          "check": "runner"
        },
        {
          "predicate": "grasp_preserved",
          "check": "runner"
        }
      ],
      "route_notes": {
        "two_hand_carry": "Callable route without a verified stable two-hand precondition."
      },
      "inputs": {
        "pose": {
          "type": "pose2d",
          "required": true
        },
        "carried_object": {
          "type": "object_id",
          "required": false
        },
        "min_bottom_z_m": {
          "type": "number",
          "required": false
        }
      },
      "routes": [
        "auto",
        "empty",
        "carry",
        "two_hand_carry"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_001",
      "legacy_id": "navigate.v1"
    },
    "pick.v1": {
      "scope": "One right-hand grasp and lift attempt for one annotated object.",
      "requires": [
        {
          "predicate": "right_hand_empty",
          "check": "runner"
        },
        {
          "predicate": "object_annotated",
          "args": [
            "object"
          ],
          "check": "policy_attempt"
        },
        {
          "predicate": "selected_grasp_route_feasible",
          "args": [
            "object"
          ],
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "held_by_right_hand",
          "args": [
            "object"
          ],
          "check": "runner"
        },
        {
          "predicate": "object_lifted",
          "args": [
            "object"
          ],
          "check": "runner"
        }
      ],
      "route_notes": {
        "floor_corner": "Callable but no successful independent physical verification."
      },
      "inputs": {
        "object": {
          "type": "object_id",
          "required": true
        },
        "base_path": {
          "type": "base_path",
          "required": false,
          "routes": [
            "moving"
          ]
        }
      },
      "routes": [
        "auto",
        "top",
        "round_rim",
        "rect_rim",
        "edge",
        "floor_corner",
        "cup_handle",
        "cavity",
        "moving"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_002",
      "legacy_id": "pick.v1"
    },
    "place.v1": {
      "scope": "One right-hand release onto one support or into one container; target type selects the verifier branch.",
      "requires": [
        {
          "predicate": "held_by_right_hand",
          "args": [
            "object"
          ],
          "check": "runner"
        },
        {
          "predicate": "target_annotated",
          "args": [
            "target"
          ],
          "check": "policy_attempt"
        },
        {
          "predicate": "target_accessible",
          "args": [
            "target"
          ],
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "inside",
          "args": [
            "object",
            "container"
          ],
          "when": "target starts with in:",
          "check": "runner"
        },
        {
          "predicate": "on",
          "args": [
            "object",
            "support"
          ],
          "when": "target does not start with in:",
          "check": "runner"
        },
        {
          "predicate": "right_hand_empty",
          "check": "runner"
        }
      ],
      "inputs": {
        "object": {
          "type": "object_id",
          "required": true
        },
        "target": {
          "type": "support_or_container_target",
          "required": true
        },
        "hint_xy_m": {
          "type": "xy",
          "required": false
        }
      },
      "routes": [
        "auto",
        "surface",
        "container",
        "edge",
        "microwave",
        "moving"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_003",
      "legacy_id": "place.v1"
    },
    "open.v1": {
      "scope": "One measured joint opening of an annotated door or drawer; object access is a separate predicate.",
      "requires": [
        {
          "predicate": "articulated_annotated",
          "args": [
            "articulated"
          ],
          "check": "runner"
        },
        {
          "predicate": "opening_route_feasible",
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "joint_open_enough",
          "args": [
            "articulated"
          ],
          "check": "runner"
        }
      ],
      "not_guaranteed": [
        "accessible(required_access_to)"
      ],
      "route_notes": {
        "while_left_holds": "Callable route lacking a verified left-hand-hold prerequisite."
      },
      "inputs": {
        "articulated": {
          "type": "articulated_id",
          "required": true
        },
        "required_access_to": {
          "type": "object_id",
          "required": false,
          "status": "not_verified"
        }
      },
      "routes": [
        "auto",
        "handle",
        "powered",
        "revolute",
        "prismatic",
        "while_left_holds"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_004",
      "legacy_id": "open.v1"
    },
    "close.v1": {
      "scope": "One measured closure of an annotated door or drawer.",
      "requires": [
        {
          "predicate": "articulated_annotated",
          "args": [
            "articulated"
          ],
          "check": "runner"
        },
        {
          "predicate": "closure_path_clear",
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "joint_closed",
          "args": [
            "articulated"
          ],
          "check": "runner"
        }
      ],
      "inputs": {
        "articulated": {
          "type": "articulated_id",
          "required": true
        }
      },
      "routes": [
        "auto",
        "handle",
        "powered"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_005",
      "legacy_id": "close.v1"
    },
    "push.v1": {
      "scope": "One directed contact move of an object along its support.",
      "requires": [
        {
          "predicate": "right_hand_empty",
          "check": "runner"
        },
        {
          "predicate": "object_on_support",
          "args": [
            "object",
            "support"
          ],
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "displacement_along",
          "args": [
            "object",
            "direction_xy",
            "enough"
          ],
          "check": "runner"
        }
      ],
      "not_guaranteed": [
        "object remains on support after the push"
      ],
      "inputs": {
        "object": {
          "type": "object_id",
          "required": true
        },
        "support": {
          "type": "support_id",
          "required": true
        },
        "direction_xy": {
          "type": "unit_vec2",
          "required": true
        },
        "distance_m": {
          "type": "positive_number",
          "required": true
        },
        "enough": {
          "type": "nonnegative_number",
          "required": false,
          "description": "Optional minimum measured progress in metres; defaults to max(0.01, distance_m * 0.5)."
        }
      },
      "routes": [
        "auto",
        "behind",
        "top_drag"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_006",
      "legacy_id": "push.v1"
    },
    "click.v1": {
      "scope": "One fresh physical button press; start may also activate the task-level heating model.",
      "requires": [
        {
          "predicate": "right_hand_empty",
          "check": "runner"
        },
        {
          "predicate": "button_reachable",
          "args": [
            "button"
          ],
          "check": "policy_attempt"
        },
        {
          "predicate": "microwave_door_closed",
          "args": [
            "appliance"
          ],
          "when": "button is start",
          "check": "policy_attempt"
        },
        {
          "predicate": "task_food_inside_cavity",
          "args": [
            "appliance"
          ],
          "when": "button is start",
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "button_pressed_this_call",
          "args": [
            "button"
          ],
          "check": "runner"
        },
        {
          "predicate": "heating_active",
          "when": "button is start",
          "check": "runner"
        }
      ],
      "not_guaranteed": [
        "food reached a requested temperature"
      ],
      "inputs": {
        "appliance": {
          "type": "articulated_id",
          "required": true
        },
        "button": {
          "type": "enum",
          "values": [
            "door",
            "start"
          ],
          "required": false,
          "default": "door",
          "description": "Only accepted as a keyword on the auto route; start route always selects start."
        }
      },
      "routes": [
        "auto",
        "start"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_007",
      "legacy_id": "click.v1"
    },
    "set_posture.v1": {
      "scope": "One measured right-arm, torso, or waist posture adjustment.",
      "requires": [
        {
          "predicate": "right_hand_empty",
          "check": "policy_attempt"
        },
        {
          "predicate": "target_within_joint_limits",
          "check": "policy_attempt"
        },
        {
          "predicate": "collision_free_motion",
          "check": "policy_attempt"
        }
      ],
      "achieves": [
        {
          "predicate": "posture_at_target",
          "check": "runner"
        }
      ],
      "not_guaranteed": [
        "a task target became reachable solely because posture changed"
      ],
      "inputs": {
        "component": {
          "type": "enum",
          "values": [
            "tuck",
            "torso",
            "waist"
          ],
          "required": true,
          "description": "Selected by the route, not passed as a positional execute argument."
        },
        "target": {
          "type": "number",
          "required": false
        }
      },
      "routes": [
        "tuck",
        "torso",
        "lower",
        "raise",
        "waist",
        "lean",
        "straighten"
      ],
      "schema_version": 1,
      "kind": "contract",
      "contract_id": "contract_008",
      "legacy_id": "set_posture.v1"
    }
  }
}
